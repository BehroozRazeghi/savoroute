# Offline search and labeled ingestion require no credentials.
# OpenAI model extraction reads OPENAI_API_KEY from the environment.
# Other provider keys are not used in this release:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# WATSONX_APIKEY=
# WATSONX_PROJECT_ID=
# Do not commit a populated .env file.

# Optional AI food interpretation (disabled by default, backend only)
# SAVOROUTE_AI_ENABLED=1
# SAVOROUTE_OPENAI_API_KEY=YOUR_SERVER_ONLY_KEY
# SAVOROUTE_AI_MODEL=gpt-6.1-terra

# Additional, separately enabled, billable web search. Do not use on public internet.
# SAVOROUTE_LIVE_ENABLED=1
# SAVOROUTE_LIVE_MODEL=gpt-6.1-terra

# OPTIONAL controlled beta admission, OFF by default.
# This is a cross-worker *request-attempt* ceiling, NOT a USD spending cap,
# user authentication, TLS termination or an anti-abuse substitute for an edge.
# Provision the SQLite parent privately, OUTSIDE the public web/repository tree.
# SAVOROUTE_BETA_ENABLED=1
# SAVOROUTE_BETA_USAGE_DB=/var/lib/savoroute-beta/admission.sqlite3
# SAVOROUTE_BETA_IDENTITY_SECRET=(generate >=32 random bytes; never commit)
# SAVOROUTE_BETA_TRUSTED_HOSTS=localhost,127.0.0.1,discover.example.com
# SAVOROUTE_BETA_AI_DAILY=20
# SAVOROUTE_BETA_LIVE_DAILY=10
# SAVOROUTE_BETA_CLIENT_MINUTE=3
