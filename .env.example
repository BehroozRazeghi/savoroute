# Offline search and labeled ingestion require no credentials.
# OpenAI model extraction reads OPENAI_API_KEY from the environment.
# Other provider keys are not used in this release:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# WATSONX_APIKEY=
# WATSONX_PROJECT_ID=
# Do not commit a populated .env file.
