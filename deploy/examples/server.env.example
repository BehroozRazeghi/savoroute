# Copy to /etc/savoroute-beta/server.env (root-owned mode 0600).
# Never commit real values. Operator must fill in secrets and domain.
SAVOROUTE_BETA_ENABLED=1
SAVOROUTE_BETA_USAGE_DB=/var/lib/savoroute-beta/usage.sqlite3
SAVOROUTE_BETA_IDENTITY_SECRET=REPLACE_WITH_PERSISTENT_RANDOM_32_PLUS_BYTE_VALUE
SAVOROUTE_BETA_TRUSTED_HOSTS=beta.example.com,localhost,127.0.0.1
SAVOROUTE_BETA_AI_DAILY=20
SAVOROUTE_BETA_LIVE_DAILY=10
SAVOROUTE_BETA_CLIENT_MINUTE=3
SAVOROUTE_AI_ENABLED=1
SAVOROUTE_LIVE_ENABLED=1
SAVOROUTE_AI_MODEL=gpt-6.1-terra
SAVOROUTE_LIVE_MODEL=gpt-6.1-terra
SAVOROUTE_LIVE_REVIEW_FILE=/var/lib/savoroute-beta/reviews.json
SAVOROUTE_OPENAI_API_KEY=REPLACE_WITH_PROJECT_SCOPED_API_KEY
