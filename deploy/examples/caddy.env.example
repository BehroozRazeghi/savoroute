# Copy to /etc/savoroute-beta/caddy.env (root-owned mode 0600).
# Password HASH must be generated with: caddy hash-password
# Only an operator-selected domain with valid DNS should be used.
SAVOROUTE_BETA_DOMAIN=beta.example.com
SAVOROUTE_BETA_USERNAME=invited-beta-user
SAVOROUTE_BETA_PASSWORD_HASH=REPLACE_WITH_CADDY_PASSWORD_HASH
